{
  "name": "three-bmfont-text",
  "version": "2.2.2",
  "description": "renders BMFont files in ThreeJS with word-wrapping",
  "module": "build/three-bmfont-text.module.js",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Matt DesLauriers",
    "email": "dave.des@gmail.com",
    "url": "https://github.com/mattdesl"
  },
  "standard": {
    "globals": [
      "THREE"
    ]
  },
  "dependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "rollup": "^3.23.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.2"
  },
  "scripts": {
    "build": "rollup -c",
    "test-msdf": " rollup --config rollup.serve.config.js -i test/test-msdf.js",
    "test-icons": " rollup --config rollup.serve.config.js -i test/test-icons.js",
    "test": "standard"
  },
  "keywords": [
    "bmfont",
    "bitmap",
    "font",
    "text",
    "three",
    "threejs",
    "quad",
    "quads",
    "batch",
    "render",
    "fonts",
    "layout",
    "word",
    "wrap",
    "word-wrap",
    "word-wrapping",
    "wrapping",
    "glyph",
    "glyphs"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/Jam3/three-bmfont-text.git"
  },
  "homepage": "https://github.com/Jam3/three-bmfont-text",
  "bugs": {
    "url": "https://github.com/Jam3/three-bmfont-text/issues"
  }
}
