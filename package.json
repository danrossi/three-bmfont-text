{
  "name": "three-bmfont-text",
  "version": "2.2.3",
  "description": "renders BMFont files in ThreeJS with word-wrapping",
  "module": "build/three-bmfont-text.module.js",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Matt DesLauriers",
    "email": "dave.des@gmail.com",
    "url": "https://github.com/mattdesl"
  },
  "standard": {
    "globals": [
      "THREE"
    ]
  },
  "dependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "rollup": "^4.39.0",
    "three-vr-orbitcontrols": "github:danrossi/three-vr-orbitcontrols"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "array-shuffle": "^3.0.0",
    "rollup-plugin-serve": "^3.0.0",
    "three": "^0.175.0",
    "word-wrap": "^1.2.5",
    "word-wrapper": "^1.0.7"
  },
  "scripts": {
    "build": "rollup -c",
